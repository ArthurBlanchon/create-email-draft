{
  // Compiler settings come from grist-widget-sdk and update with it. This
  // file keeps what is specific to this widget: its files and types.
  "extends": "grist-widget-sdk/tsconfig/node.json",
  "compilerOptions": {
    // Also set in the base. Repeated so that a missing base (a grist-widget-sdk
    // too old to ship it) fails the typecheck without writing a .js file.
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "types": ["node"]
  },
  "include": ["vite.config.ts"]
}
